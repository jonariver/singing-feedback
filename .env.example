# Kopieren nach .env und ausfuellen. .env wird nie eingecheckt (siehe .gitignore)
# und der Key wird ausschliesslich serverseitig (backend/feedback) gelesen - landet nie im Frontend.
ANTHROPIC_API_KEY=

# Optional: Modellauswahl fuer die Feedback-Generierung (Phase 6)
ANTHROPIC_MODEL=claude-sonnet-5

# Optional, nur relevant wenn das Backend nicht mehr rein lokal via run.py laeuft:
# komma-getrennte Liste erlaubter Origins fuers CORS (z.B. https://meine-app.example).
# Native Mobile-Clients (Flutter) brauchen das nicht - CORS ist ein Browser-Mechanismus.
CORS_ALLOWED_ORIGINS=
