# Kopieren nach .env und ausfuellen. .env wird nie eingecheckt (siehe .gitignore)
# und der Key wird ausschliesslich serverseitig (backend/feedback) gelesen - landet nie im Frontend.
ANTHROPIC_API_KEY=

# Optional: Modellauswahl fuer die Feedback-Generierung (Phase 6)
ANTHROPIC_MODEL=claude-sonnet-5
